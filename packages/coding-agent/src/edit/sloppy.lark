// Canonical grammar for the sloppy edit payload (constrained decoding).
//
// Shape:
//   [path]            file header
//   « / «*            start MATCH (one/every match)
//   <match lines>     current-text pattern with … gaps and selections
//                      Preferred selection: ⟪old│new⟫; no » follows.
//                      Legacy selection: ⟪old⟫; a » starts whole REWRITE.
//   »                 optional legacy REWRITE separator
//   <rewrite lines>   final text; »N re-emits earlier deleted text
//
// A »N line is accepted in MATCH for an inline desired side; runtime checks
// its placement and rejects legacy MATCH references.
start: section+
section: header op+
header: "[" PATH "]" LF
PATH: /[^\]\n]+/
op: match_header match_line+ rewrite?

match_header: "«" ALL? LF
ALL: "*"

rewrite: rewrite_sep rewrite_line*
rewrite_sep: "»" LF
rewrite_line: reemit_line | content_line | blank_line

match_line: reemit_line | content_line | blank_line
content_line: /[^«»\n][^\n]*/ LF
reemit_line: "»" /[1-9][0-9]*/ LF
blank_line: LF

%import common.LF
